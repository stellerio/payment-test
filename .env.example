# Copy this file to .env for local development. Never commit real keys.
PORT=3000
BASE_URL=http://localhost:3000

# Stripe: use test keys first, then switch to live keys after testing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# PayPal: use Sandbox credentials first.
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_ENV=sandbox
# Product details (price is in the smallest currency unit, e.g. 500 = $5.00)
PRODUCT_NAME=My digital product
PRODUCT_DESCRIPTION=A product from my store.
PRODUCT_PRICE_CENTS=500
PRODUCT_CURRENCY=usd
STORE_NAME=Payment Test
